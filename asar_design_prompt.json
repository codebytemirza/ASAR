{
    "project_name": "ASAR Systech",
    "design_type": "Enterprise Portfolio Website",
    "industry": "Technology / AI / Cybersecurity / ISO Compliance",
    "overall_style": {
        "tone": "Bold, Intelligent, Secure, High-Performance",
        "layout": "Grid-based, Full-viewport sections (min-height: 100vh), Split-screen heroes",
        "aesthetic": "Primal/Athletic Tech - Sharp corners, solid shadows, clean whitespace",
        "emotional_hook": "Confidence through compliance; Emotional Intelligence in automation"
    },
    "color_palette": {
        "primary": "#7C8CFF",
        "primary_dark": "#6370CC",
        "background": "#EEF1FF",
        "foreground": "#000000",
        "muted_bg": "#E0E4F5",
        "muted_text": "#333333",
        "border": "#D1D5E5",
        "accent_white": "#FFFFFF"
    },
    "typography": {
        "font_family": "Inter, sans-serif",
        "headlines": {
            "weight": "900 (Black)",
            "case": "UPPERCASE",
            "letter_spacing": "-0.02em"
        },
        "body": {
            "weight": "400/500",
            "line_height": "1.6"
        },
        "labels": {
            "weight": "800",
            "case": "UPPERCASE",
            "letter_spacing": "0.15em"
        }
    },
    "logo_concept": {
        "name": "ASAR (عصر)",
        "style": "Sine Tech / Calligraphic Abstraction",
        "elements": [
            "Vertical Data Line (Alif)",
            "Sine Wave with Data Nodes (Se)",
            "Downward Flow Curve (Ray)"
        ],
        "meaning": "Time/Era combined with technological fluidity"
    },
    "site_structure": {
        "architecture": "Multi-page Static HTML",
        "pages": [
            {
                "name": "Home",
                "focus": "High-level overview, Trust Indicators, Hero Split-layout"
            },
            {
                "name": "Services",
                "focus": "Deep dive into ISO Standards (16+) and AI/SOC services",
                "key_content": [
                    "ISO 27001, 20000-1, 9001, 27701, 42001",
                    "NCA, SAMA, PDPL, HIPAA Compliance",
                    "Methodology: Gap Assessment -> Audit Readiness",
                    "AI: Agentic Workflows, Computer Vision (YOLO), Data Eng"
                ]
            },
            {
                "name": "Technology",
                "focus": "Tech Stack Badges & Categories",
                "stack": [
                    "Python",
                    "n8n",
                    "LangChain",
                    "Wazuh",
                    "Splunk",
                    "React",
                    "Docker"
                ]
            },
            {
                "name": "About / Industries",
                "focus": "Sectors served (Healthcare, Fintech, Telecom, Manufacturing)",
                "mission": "Strategic Partners in Transformation"
            },
            {
                "name": "Contact",
                "focus": "Lead Generation Form",
                "fields": [
                    "Name",
                    "Email",
                    "Interest (ISO, AI, SOC)",
                    "Message"
                ]
            }
        ]
    },
    "ui_components": {
        "buttons": {
            "style": "Rounded rectangle (4px radius)",
            "primary": "Solid Primary Color + Solid Bottom Shadow",
            "outline": "2px Solid Border, Uppercase Text"
        },
        "cards": {
            "style": "White bg, Solid Border, Thick Left Accent Border (Primary Color)",
            "interaction": "Lift up (-4px) + Shadow reveal on hover"
        },
        "icons": {
            "style": "Lucide-style SVG paths (No Emojis)",
            "examples": "Clipboard (ISO), Robot (AI), Shield (SOC), Eye (Vision)"
        }
    },
    "content_strategy": {
        "key_phrase_1": "Build Smart. Secure Better. Automate All.",
        "key_phrase_2": "Emotional Intelligence in Code.",
        "key_phrase_3": "Solutions That Scale & Secure."
    },
    "responsive_behavior": {
        "desktop": "2-Column Grids, Spacious 1400px Container",
        "mobile": "Single Column Stack, Hamburger Menu, Adjusted Typography size"
    }
}